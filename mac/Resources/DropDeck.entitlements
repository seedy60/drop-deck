<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed. The app references sound files where they sit, all over
	     the user's drives, and never copies them. A sandbox would break every
	     board on the first launch after an update. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The camera, for a picture that is a camera or the screen with the
	     camera in a corner. Under the hardened runtime an app WITHOUT this is
	     never listed in System Settings, Privacy and Security, Camera, however
	     many times it asks, so it can never be granted: Raymond, in-app
	     reports 38 and 43. The usage string in Info.plist is not enough on its
	     own. SelfTest reads this back out of the signed bundle. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- The hardened runtime blocks loading unsigned Audio Units into the
	     process. Tony's plugin folder is full of them, so hosting a plugin
	     needs this. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
